; ** Install CubicIDE-ACE plugin into CubicIDE **
;
; Run this script from the CubicIDE-ACE directory:
;   execute Install
;
; Copies add-ons/ into golded: and registers presets via regedit.

; Check if golded: assign exists
IF EXISTS golded:
  echo ""
  echo "CubicIDE-ACE Plugin Installer"
  echo "=============================="
  echo ""
  echo "This will install the ACE plugin into CubicIDE:"
  echo "  - Copy add-ons/ace/ into golded:add-ons/"
  echo "  - Register presets and filetype via regedit"
  echo ""
  ASK "Continue? (y/n) "
  IF WARN
    echo ""
    echo "Copying add-ons..."
    copy add-ons golded:add-ons ALL CLONE
    echo "Registering presets and filetype..."
    golded:add-ons/regedit/regedit script=install.bat
    echo "Copying uninstall script..."
    copy install.bat golded:etc/uninstall/ace.bat
    echo ""
    echo "Installation complete."
    echo "Please (re)start CubicIDE to activate the plugin."
    echo ""
    echo "To uninstall later, run:"
    echo "  golded:add-ons/regedit/regedit script=golded:etc/uninstall/ace.bat UNINSTALL"
  ELSE
    echo "Installation cancelled."
  ENDIF
ELSE
  echo "Error: golded: assign not found."
  echo "CubicIDE must be installed and the golded: assign must be set."
ENDIF
