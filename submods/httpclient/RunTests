.key outfile
; RunTests - HTTP client test runner
; Compiles and runs tests (module .o must already exist)
; Run from ace:submods/httpclient/
;
; Usage:
;   cd ace:submods/httpclient
;   execute RunTests                     ; output to console
;   execute RunTests ace:test-output.txt ; output to file

IF "<outfile>" EQ ""
  SET ofile *
ELSE
  SET ofile "<outfile>"
ENDIF

FAILAT 21
STACK 65000
SET nPass 0
SET nFail 0

echo "" >>$ofile
echo "=======================================" >>$ofile
echo "  HTTPClient Test Suite" >>$ofile
echo "=======================================" >>$ofile
echo "" >>$ofile

; --- test_tcp ---
echo "--- test_tcp ---" >>$ofile
bas test_tcp >>$ofile
IF WARN
  echo "  *** BUILD FAILED ***" >>$ofile
  SET nFail `eval $nFail + 1`
  SKIP next2
ENDIF
test_tcp >T:_hctest.tmp
type T:_hctest.tmp >>$ofile
search T:_hctest.tmp "ASSERT FAILED" QUIET
IF NOT WARN
  echo "  >>> FAILED <<<" >>$ofile
  SET nFail `eval $nFail + 1`
ELSE
  echo "  PASSED" >>$ofile
  SET nPass `eval $nPass + 1`
ENDIF
LAB next2
echo "" >>$ofile

