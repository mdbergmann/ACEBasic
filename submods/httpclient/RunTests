echo "  Results: $nPass passed, $nFail failed" >>$ofile
echo "=======================================" >>$ofile
IF VAL $nFail GT 0
  echo "" >>$ofile
  echo "  !!! SOME TESTS FAILED !!!" >>$ofile
  echo "" >>$ofile
ENDIF

delete T:_hctest.tmp QUIET
